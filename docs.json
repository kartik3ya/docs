{
  "$schema": "https://mintlify.com/docs.json",
  "theme": "mint",
  "name": "Checkobot API",
  "description": "Endpoints, authentication, errors and code samples for the Checkobot AI image detection API.",
  "colors": {
    "primary": "#4d7c0f",
    "light": "#c6f24e",
    "dark": "#121812"
  },
  "fonts": {
    "heading": { "family": "Bricolage Grotesque", "weight": 700 },
    "body": { "family": "IBM Plex Sans" }
  },
  "favicon": "/favicon.svg",
  "logo": {
    "light": "/logo/light.svg",
    "dark": "/logo/dark.svg",
    "href": "https://checkobot.ai"
  },
  "navigation": {
    "groups": [
      {
        "group": "Get started",
        "pages": ["index", "authentication"]
      },
      {
        "group": "Endpoints",
        "pages": ["check", "batch", "usage"]
      },
      {
        "group": "Reference",
        "pages": ["image-storage", "errors", "limits"]
      }
    ],
    "global": {
      "anchors": [
        { "anchor": "Check an image", "href": "https://checkobot.ai", "icon": "image" },
        { "anchor": "Pricing", "href": "https://checkobot.ai/pricing", "icon": "tag" },
        { "anchor": "Status", "href": "https://checkobot.ai/status", "icon": "signal" }
      ]
    }
  },
  "navbar": {
    "links": [{ "label": "Contact sales", "href": "mailto:sales@checkobot.ai" }],
    "primary": {
      "type": "button",
      "label": "Get an API key",
      "href": "https://checkobot.ai/dashboard/keys"
    }
  },
  "contextual": {
    "options": ["copy", "view", "chatgpt", "claude", "perplexity", "mcp", "cursor", "vscode"]
  },
  "footer": {
    "links": [
      {
        "header": "Checkobot",
        "items": [
          { "label": "Check an image", "href": "https://checkobot.ai" },
          { "label": "Pricing", "href": "https://checkobot.ai/pricing" },
          { "label": "Privacy", "href": "https://checkobot.ai/privacy" }
        ]
      }
    ]
  }
}
